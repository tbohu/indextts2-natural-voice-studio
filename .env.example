# 官方 IndexTTS 代码目录
INDEXTTS_REPO="/absolute/path/to/index-tts"

# 官方 IndexTTS-2.5 模型目录，里面必须有 config.yaml
INDEXTTS_MODEL_DIR="/absolute/path/to/IndexTTS-2.5"

# IndexTTS 虚拟环境的 Python
INDEXTTS_PYTHON="/absolute/path/to/index-tts/.venv/bin/python3"

# 以下三项可留空，启动后在网页上传音频即可
# INDEXTTS_DEFAULT_VOICE="/absolute/path/to/authorized_voice.wav"
# INDEXTTS_DEFAULT_EMOTION="/absolute/path/to/authorized_emotion.wav"
# INDEXTTS_BASELINE_AUDIO="/absolute/path/to/baseline.wav"

